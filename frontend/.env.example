# Base URL of the backend's /api/v1 (backend/kairos/urls.py). Django's
# default dev server port (manage.py runserver).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Real OIDC provider (RFC v1.0 §4) — left empty by default, matching the
# backend's own OIDC_ISSUER/OIDC_CLIENT_ID default (.env.example at the
# repo root). Leaving these unset disables the "Sign in with SSO" button
# (kairos.core.rate_limit-style "structurally present but not usable
# without real config" pattern) — src/auth/oidc.ts is genuinely untested
# against a live IdP, same documented gap as the backend's own
# verify_id_token real-JWKS path.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
