# ==========================================================
# Database
# ==========================================================
# The RUNNING APPLICATION's connection (manage.py runserver / wsgi) — the
# least-privilege kairos_app role (Phase 8): ordinary DML on every app
# table, INSERT/SELECT-only (never UPDATE/DELETE) on audit_log, enforced
# by Postgres grants, not application code.
DATABASE_URL=postgresql://kairos_app:kairos_app@localhost:5432/kairos_dev
# Migrations need DDL privileges kairos_app deliberately doesn't have —
# temporarily override DATABASE_URL to THIS superuser DSN for
# `manage.py migrate` (and only for that command) rather than widening
# kairos_app's grants. Not read automatically; see README.md.
DATABASE_URL_MIGRATE=postgresql://kairos:kairos@localhost:5432/kairos_dev
DATABASE_URL_TEST=postgresql://kairos:kairos@localhost:5432/kairos_test

# Write-path session settings (RFC v1.0 §7.1) — tune from Rollout §9
DB_LOCK_TIMEOUT=3s
DB_STATEMENT_TIMEOUT=10s
DB_IDLE_IN_TRANSACTION_TIMEOUT=30s

# ==========================================================
# Celery / Redis (Phase 13) — a LIVENESS dependency only (RFC v1.0 §4.3):
# the exclusion constraint holds with no worker running at all.
# ==========================================================
REDIS_URL=redis://localhost:6379/0
ROLLING_MATERIALIZATION_INTERVAL_SECONDS=3600  # hourly (PRD FR14c)
TZDATA_REMATERIALIZATION_INTERVAL_SECONDS=3600 # hourly (RFC v1.0 §9.4)
TZDATA_DRIFT_CHECK_INTERVAL_SECONDS=86400      # daily (Test Plan TZ-03 Test B)

# ==========================================================
# Correctness monitoring (Phase 20) — PRD M2/M3; RFC v1.0 §14
# ==========================================================
RECONCILIATION_INTERVAL_SECONDS=3600           # hourly
SCHEMA_ASSERTION_INTERVAL_SECONDS=3600         # hourly + on every deploy
# Heartbeat staleness thresholds (Rollout v1.0 §6.1) — 2x the owning
# interval above for the four interval-driven checks (kairos/core/
# constants.py computes this same default if the var below is unset;
# shown here as the literal value, not blank, matching every other
# entry in this file).
RECONCILIATION_STALE_THRESHOLD_SECONDS=7200
SCHEMA_ASSERTION_STALE_THRESHOLD_SECONDS=7200
SERIES_MATERIALIZATION_STALE_THRESHOLD_SECONDS=7200
TZDATA_REMATERIALIZATION_STALE_THRESHOLD_SECONDS=7200
OFFER_CASCADE_STALE_THRESHOLD_SECONDS=90       # event-triggered, not interval-driven

# ==========================================================
# Domain constants (Spec v1.0 / PRD v1.0 — all tunable per Rollout §9)
# ==========================================================
OFFER_WINDOW_MINUTES=15          # PRD open question 1
HOLD_REAPER_INTERVAL_SECONDS=30  # RFC v1.0 §10.4
IDEMPOTENCY_RETENTION_HOURS=24   # PRD FR37
MAX_SERIES_OCCURRENCES=100       # PRD FR14a
MAX_ADVANCE_HORIZON_DAYS=365     # PRD FR14b
MAX_AVAILABILITY_QUERY_DAYS=92   # PRD FR30
PREVIEW_TOKEN_TTL_SECONDS=900    # Spec v1.0 §5.8 — was misnamed
                                  # PREVIEW_TOKEN_TTL_MINUTES here until
                                  # Phase 13 found the mismatch against
                                  # what Phase 12 actually implemented
                                  # (kairos/core/constants.py)

# ==========================================================
# Auth (Phase 9)
# ==========================================================
# Real OIDC provider config — unused in local dev/test, where a fixed
# mock-issuer keypair (kairos/identity/oidc.py) stands in instead.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Signs this backend's OWN short-lived session token (RFC v1.0 §4) — HS256,
# distinct from DJANGO_SECRET_KEY so rotating one doesn't force rotating
# the other. Falls back to DJANGO_SECRET_KEY, then to an insecure dev-only
# literal, if unset — prod.py refuses to start with that literal in play.
KAIROS_SESSION_SIGNING_KEY=
KAIROS_SESSION_TOKEN_TTL_SECONDS=900

# ==========================================================
# Notifications (Phase 18) — SMTP_* used only by EMAIL_BACKEND=smtp
# (kairos.settings.prod); dev/test use Django's own console/locmem
# backends instead and never read these.
# ==========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_FROM_EMAIL=kairos@example.com
NOTIFICATION_MAX_RETRIES=5             # PRD FR55 — "recorded and retried"
NOTIFICATION_RETRY_BACKOFF_MAX_SECONDS=600
